<?xml version="1.0" encoding="utf-8"?>
<!-- App in the More apps grid: banner + name. The banner follows the tile's focus state. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="14dp"
    android:clipChildren="false"
    android:focusable="true"
    android:longClickable="true"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/tile_image"
        android:layout_width="120dp"
        android:layout_height="68dp"
        android:background="@drawable/grid_tile_shape"
        android:duplicateParentState="true"
        android:foreground="@drawable/grid_tile_focus" />

    <TextView
        android:id="@+id/tile_label"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:fontFamily="sans-serif-light"
        android:maxLines="1"
        android:paddingHorizontal="2dp"
        android:textColor="@color/grid_label"
        android:textSize="12sp" />
</LinearLayout>
