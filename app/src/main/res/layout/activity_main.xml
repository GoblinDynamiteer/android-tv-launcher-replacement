<?xml version="1.0" encoding="utf-8"?>
<!-- Layout D from design/mockups.html; mockup px on the 1920 px canvas = dp x 2. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipChildren="false">

    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <!-- The focused item's own wallpaper, faded in over the default (ItemWallpapers). -->
    <ImageView
        android:id="@+id/wallpaper_fade"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="92dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-thin"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:letterSpacing="-0.03"
            android:textColor="@color/text"
            android:textSize="105sp" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:alpha="0.8"
            android:fontFamily="sans-serif-light"
            android:format12Hour="EEEE d MMMM"
            android:format24Hour="EEEE d MMMM"
            android:includeFontPadding="false"
            android:textColor="@color/text"
            android:textSize="19sp" />
    </LinearLayout>

    <!-- Hue scenes (design/hue-mockups.html, H1): bulb icon, then the current scene. -->
    <se.kampe.tvlauncher.GlassView
        android:id="@+id/hue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="32dp"
        android:layout_marginTop="26dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp"
        android:visibility="gone">

        <!-- 30dp with 5dp padding: folded, the bar is a 38dp circle around it. -->
        <ImageView
            android:id="@+id/hue_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="1dp"
            android:alpha="0.75"
            android:contentDescription="@string/hue"
            android:padding="5dp"
            android:src="@drawable/ic_lightbulb" />

        <LinearLayout
            android:id="@+id/hue_current"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/input_segment"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="9dp"
            android:paddingEnd="12dp">

            <se.kampe.tvlauncher.PaletteDot
                android:id="@+id/hue_dot"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:duplicateParentState="true" />

            <TextView
                android:id="@+id/hue_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:duplicateParentState="true"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/input_label"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/hue_room"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="2dp"
                android:alpha="0.6"
                android:duplicateParentState="true"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/input_label"
                android:textSize="9sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:alpha="0.6"
                android:duplicateParentState="true"
                android:text="@string/chevron_down"
                android:textColor="@color/input_label"
                android:textSize="10sp" />
        </LinearLayout>
    </se.kampe.tvlauncher.GlassView>

    <!-- HDMI inputs (design/inputs-mockups.html, I2): gamepad icon, then one segment per input. -->
    <se.kampe.tvlauncher.GlassView
        android:id="@+id/inputs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="26dp"
        android:layout_marginEnd="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp"
        android:visibility="gone">

        <!-- 30dp with 5dp padding: folded, the bar is a 38dp circle around it. -->
        <ImageView
            android:id="@+id/inputs_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="1dp"
            android:alpha="0.75"
            android:contentDescription="@string/inputs"
            android:padding="5dp"
            android:src="@drawable/ic_gamepad" />
    </se.kampe.tvlauncher.GlassView>

    <se.kampe.tvlauncher.GlassView
        android:id="@+id/dock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="320dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="7dp"
        android:paddingVertical="11dp" />

    <!-- Shown while an app is being moved along the dock. -->
    <TextView
        android:id="@+id/move_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="432dp"
        android:background="@drawable/hint_background"
        android:paddingHorizontal="12dp"
        android:paddingVertical="7dp"
        android:text="@string/move_hint"
        android:textColor="@color/text"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- Hue scene list, dropped below the Hue bar over a dimmed home screen. -->
    <View
        android:id="@+id/hue_dim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#59000000"
        android:visibility="gone" />

    <se.kampe.tvlauncher.GlassView
        android:id="@+id/hue_panel"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="32dp"
        android:layout_marginTop="73dp"
        android:orientation="vertical"
        android:padding="9dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="9dp"
            android:paddingTop="3dp"
            android:paddingBottom="7dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.55"
                android:text="@string/arrow_left"
                android:textColor="@color/text"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/hue_group"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:alpha="0.7"
                android:gravity="center"
                android:letterSpacing="0.15"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textColor="@color/text"
                android:textSize="9.5sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.55"
                android:text="@string/arrow_right"
                android:textColor="@color/text"
                android:textSize="9sp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/hue_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/hue_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </se.kampe.tvlauncher.GlassView>
</FrameLayout>
