<?xml version="1.0" encoding="utf-8"?>
<!-- One HDMI input in the input bar: status dot and name. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="30dp"
    android:background="@drawable/input_segment"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="9dp"
    android:paddingEnd="12dp">

    <View
        android:id="@+id/dot"
        android:layout_width="6dp"
        android:layout_height="6dp" />

    <TextView
        android:id="@+id/label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:duplicateParentState="true"
        android:fontFamily="sans-serif-light"
        android:includeFontPadding="false"
        android:textColor="@color/input_label"
        android:textSize="12sp" />

    <!-- "waking…" while the device is woken over the network. -->
    <TextView
        android:id="@+id/sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="2dp"
        android:alpha="0.6"
        android:duplicateParentState="true"
        android:fontFamily="sans-serif-light"
        android:includeFontPadding="false"
        android:text="@string/input_waking"
        android:textColor="@color/input_label"
        android:textSize="9sp"
        android:visibility="gone" />
</LinearLayout>
